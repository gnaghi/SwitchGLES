# Normalize line endings: text files are stored and checked out as LF.
# (Matches .editorconfig end_of_line = lf.)
* text=auto eol=lf

# Real tabs / LF for Makefiles.
Makefile  text eol=lf
*.mk      text eol=lf

# Binary files — never normalize.
*.png   binary
*.jpg   binary
*.7z    binary
*.zip   binary
*.nro   binary
*.nso   binary
*.nacp  binary
*.elf   binary
*.dksh  binary
*.bin   binary
*.qpa   binary
*.a     binary
